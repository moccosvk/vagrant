# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Predvolený box (preferencia: generic/ubuntu2204)
  config.vm.box = "generic/ubuntu2204"

  # Voliteľne vypnúť automatické kontroly aktualizácií boxu
  # config.vm.box_check_update = false

  # Spoločné nastavenia pre všetky VM
  config.vm.provider "virtualbox" do |vb|
    vb.gui = false
  end

  # Definícia uzlov k3s
  nodes = [
    { name: "k3s-master",   hostname: "k3s-master",   ip: "192.168.230.10", mem: 3072, cpus: 2 },
    { name: "k3s-worker-1", hostname: "k3s-worker-1", ip: "192.168.230.11", mem: 2048, cpus: 2 },
    { name: "k3s-worker-2", hostname: "k3s-worker-2", ip: "192.168.230.12", mem: 2048, cpus: 2 },
  ]

  nodes.each do |n|
    config.vm.define n[:name] do |node|
      node.vm.hostname = n[:hostname]

      # Bridged sieť (ponechaný tvoj konkrétny adaptér)
      node.vm.network "public_network",
        type: "bridged",
        bridge: "Intel(R) Ethernet Connection (17) I219-LM"

      # Host-Only sieť so statickou IP (ponechaný tvoj konkrétny adaptér)
      node.vm.network "private_network",
        type: "static",
        ip: n[:ip],
        name: "VirtualBox Host-Only Ethernet Adapter #2"

      node.vm.provider "virtualbox" do |vb|
        vb.name   = n[:name]
        vb.memory = n[:mem]
        vb.cpus   = n[:cpus]
        # Odporúčané pre k8s/k3s: zapnúť paravirtualizáciu KVM a I/O APIC
        vb.customize ["modifyvm", :id, "--paravirtprovider", "kvm"]
        vb.customize ["modifyvm", :id, "--ioapic", "on"]
      end

      # (Voliteľne) vypnúť zdieľaný priečinok vagrant (niekedy mätie kontajnery)
      # node.vm.synced_folder ".", "/vagrant", disabled: true
    end
  end
end
